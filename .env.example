NODE_ENV=development
PORT=5000
CLIENT_URL=http://localhost:5173
GEMINI_API_KEY=your_gemini_api_key_here

# ── Firebase Configuration ──────────────────────────────────────────────────
# OPTION A (recommended for local dev):
#   1. Go to Firebase Console → Project Settings → Service Accounts
#   2. Click "Generate new private key" → save as server/serviceAccountKey.json
#   3. Set the path below (relative to server/ directory)
FIREBASE_SERVICE_ACCOUNT_PATH=./serviceAccountKey.json

# OPTION B (for deployment / environment variables):
#   Paste the entire serviceAccountKey.json content as a single-line JSON string
# FIREBASE_SERVICE_ACCOUNT={"type":"service_account","project_id":"..."}

# Your Firebase project ID (found in Firebase Console → Project Settings)
FIREBASE_PROJECT_ID=healthpulse-nagpur
